# Copy this file to .env and fill in real values for local dev / deployment

# Database
DATABASE_URL=sqlite:///./career_platform.db

# Auth
SECRET_KEY=change-this-to-a-long-random-string

# AI service: "demo" (no external calls, canned responses) or "external"
AI_MODE=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
